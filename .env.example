# --- Required ---

# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your Telegram user ID (DM @userinfobot on Telegram to find it).
# Required for /stats, /health, /metrics, /active commands and owner DMs.
BOT_OWNER_ID=


# --- Storage ---

# Path to SQLite database file (default: ./raffle.db, inside container: /data/raffle.db)
DATABASE_PATH=./raffle.db

# Auto-delete completed raffle data after this many hours (0 = keep forever)
# Examples: 24 = 1 day, 72 = 3 days, 168 = 1 week, 720 = 30 days
DATA_RETENTION_HOURS=720


# --- Uptime monitoring (optional but recommended) ---

# Healthchecks.io / UptimeRobot / BetterUptime ping URL.
# Bot pings this every 5 min; you get alerted if pings stop.
# Leave unset to disable.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_MS=300000


# --- Logging ---

# debug | info | warn | error  (default: info)
LOG_LEVEL=info

# Set to "1" for human-readable logs in dev. JSON is default for prod.
LOG_PRETTY=


# --- Webhooks (optional — defaults to long-polling if unset) ---

# Public HTTPS URL routed to this container's WEBHOOK_PORT.
# When set, the bot switches from polling to webhook mode. See RECOVERY.md.
WEBHOOK_URL=
# Random secret token used to validate Telegram's webhook POSTs.
WEBHOOK_SECRET=
# Port the bot's HTTP server listens on (default 3001).
WEBHOOK_PORT=3001


# --- Admin server (for Bot Control Tower) ---

# Shared key gating the /admin/summary endpoint. Leave unset to disable auth-gated routes.
ADMIN_KEY=
ADMIN_PORT=8787
