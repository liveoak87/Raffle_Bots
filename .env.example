# Discord Bot Token — get from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Application (Client) ID — found on the application's General Information page
CLIENT_ID=your_application_client_id_here

# Your Discord user ID — enables owner-only commands (e.g. /randomizer status)
OWNER_ID=your_discord_user_id_here

# Path to the SQLite database file.
# In Docker this is set by the Dockerfile (ENV DATABASE_PATH=/app/data/raffle.db).
# Leave unset to use the default (data/raffle.db, falling back to ./raffle.db).
# DATABASE_PATH=/app/data/raffle.db

# ── Admin dashboard ──────────────────────────────────────────────────────────
# Port the dashboard listens on (mapped to a host port by docker-compose).
DASHBOARD_PORT=3000

# Password for the dashboard login.
DASHBOARD_PASSWORD=change_me

# Long random string used to sign dashboard session cookies. REQUIRED in production —
# if unset, a random per-process secret is generated (sessions won't survive a restart).
# Generate one with: openssl rand -hex 48
DASHBOARD_SESSION_SECRET=generate_a_long_random_value

# Optional contact shown on the public /terms and /privacy pages.
# SUPPORT_CONTACT=you@example.com
