# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Optional: path to SQLite database file (default: ./raffle.db)
DATABASE_PATH=./raffle.db

# Auto-delete completed raffle data after this many hours (0 = keep forever)
# Set this to automatically purge all participant data, entries, and winners
# from drawn/cancelled raffles after the specified time.
# Examples: 24 = 1 day, 72 = 3 days, 168 = 1 week
DATA_RETENTION_HOURS=24
